<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="sulu_headless.event_subscriber.navigation_invalidation"
                 class="Sulu\Bundle\HeadlessBundle\EventSubscriber\NavigationInvalidationSubscriber">
            <argument type="service" id="sulu_http_cache.cache_manager" on-invalid="null"/>
            <argument type="service" id="sulu_content.content_aggregator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
