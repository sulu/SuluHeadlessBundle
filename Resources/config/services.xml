<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Extension Resolvers -->
        <service
            id="sulu_headless.excerpt_resolver"
            class="Sulu\Bundle\HeadlessBundle\Content\ExtensionResolver\ExcerptResolver"
        >
            <argument type="service" id="sulu_admin.form_metadata_provider"/>
            <argument type="service" id="sulu_headless.content_resolver"/>
            <tag name="sulu_headless.extension_resolver"/>
        </service>

        <service
            id="sulu_headless.seo_resolver"
            class="Sulu\Bundle\HeadlessBundle\Content\ExtensionResolver\SeoResolver"
        >
            <argument type="service" id="sulu_admin.form_metadata_provider"/>
            <argument type="service" id="sulu_headless.content_resolver"/>
            <tag name="sulu_headless.extension_resolver"/>
        </service>

        <service
            id="sulu_headless.extension_resolver_provider"
            class="Sulu\Bundle\HeadlessBundle\Content\ExtensionResolver\ExtensionResolverProvider"
        >
            <argument type="tagged_iterator" tag="sulu_headless.extension_resolver"/>
        </service>

        <service
            id="sulu_headless.structure_resolver"
            class="Sulu\Bundle\HeadlessBundle\Content\StructureResolver"
            public="true"
        >
            <argument type="service" id="sulu_admin.form_metadata_provider"/>
            <argument type="service" id="sulu_headless.content_resolver"/>
            <argument type="service" id="sulu_http_cache.reference_store"/>
            <argument type="service" id="sulu_headless.extension_resolver_provider"/>
        </service>
        <service id="Sulu\Bundle\HeadlessBundle\Content\StructureResolverInterface" alias="sulu_headless.structure_resolver"/>

        <service
            id="sulu_headless.content_resolver"
            class="Sulu\Bundle\HeadlessBundle\Content\ContentResolver"
            public="true"
        >
            <argument type="tagged" tag="sulu_headless.content_type_resolver" default-index-method="getContentType" index-by="type"/>
        </service>
        <service id="Sulu\Bundle\HeadlessBundle\Content\ContentResolverInterface" alias="sulu_headless.content_resolver"/>    </services>
</container>
