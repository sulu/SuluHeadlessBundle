<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
            id="sulu_headless.provider_resolver.media"
            class="Sulu\Bundle\HeadlessBundle\Content\DataProviderResolver\MediaDataProviderResolver"
        >
            <argument type="service" id="sulu_media.media_smart_content_provider"/>
            <argument type="service" id="sulu_headless.serializer.media"/>
            <argument type="service" id="sulu.repository.media"/>

            <tag name="sulu_headless.data_provider_resolver"/>
        </service>

        <service
            id="sulu_headless.provider_resolver.contact"
            class="Sulu\Bundle\HeadlessBundle\Content\DataProviderResolver\ContactDataProviderResolver"
        >
            <argument type="service" id="sulu_contact.contact_smart_content_provider"/>
            <argument type="service" id="sulu_headless.serializer.contact"/>
            <argument type="service" id="sulu.repository.contact"/>

            <tag name="sulu_headless.data_provider_resolver"/>
        </service>

        <service
            id="sulu_headless.provider_resolver.account"
            class="Sulu\Bundle\HeadlessBundle\Content\DataProviderResolver\AccountDataProviderResolver"
        >
            <argument type="service" id="sulu_contact.account_smart_content_provider"/>
            <argument type="service" id="sulu_headless.serializer.account"/>
            <argument type="service" id="sulu.repository.account"/>

            <tag name="sulu_headless.data_provider_resolver"/>
        </service>

        <service
            id="sulu_headless.provider_resolver.page"
            class="Sulu\Bundle\HeadlessBundle\Content\DataProviderResolver\PageDataProviderResolver"
        >
            <argument type="service" id="sulu_page.page_smart_content_provider"/>
            <argument type="service" id="sulu_headless.structure_resolver"/>
            <argument type="service" id="Sulu\Page\Domain\Repository\PageRepositoryInterface"/>
            <argument type="service" id="Sulu\Content\Application\ContentAggregator\ContentAggregatorInterface"/>
            <argument type="expression">container.hasParameter('sulu.preview') ? parameter('sulu.preview') : false</argument>

            <tag name="sulu_headless.data_provider_resolver"/>
        </service>

        <service
            id="sulu_headless.provider_resolver.snippet"
            class="Sulu\Bundle\HeadlessBundle\Content\DataProviderResolver\SnippetDataProviderResolver"
        >
            <argument type="service" id="sulu_snippet.snippet_smart_content_provider"/>
            <argument type="service" id="sulu_headless.structure_resolver"/>
            <argument type="service" id="Sulu\Snippet\Domain\Repository\SnippetRepositoryInterface"/>
            <argument type="service" id="Sulu\Content\Application\ContentAggregator\ContentAggregatorInterface"/>

            <tag name="sulu_headless.data_provider_resolver"/>
        </service>
    </services>
</container>
