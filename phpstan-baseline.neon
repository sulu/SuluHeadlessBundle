			message: "#^Method Sulu\\\\Bundle\\\\HeadlessBundle\\\\Content\\\\DataProviderResolver\\\\ContactDataProviderResolver\\:\\:extractSortBys\\(\\) has parameter \\$filters with no value type specified in iterable type array\\.$#"
			count: 1
