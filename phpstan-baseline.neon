		-
			message: "#^Method Sulu\\\\Bundle\\\\HeadlessBundle\\\\Content\\\\DataProviderResolver\\\\MediaDataProviderResolver\\:\\:extractSortBys\\(\\) has parameter \\$filters with no value type specified in iterable type array\\.$#"
			count: 1
			path: Content/DataProviderResolver/MediaDataProviderResolver.php

		-
			message: "#^Method Sulu\\\\Bundle\\\\HeadlessBundle\\\\Content\\\\DataProviderResolver\\\\PageDataProviderResolver\\:\\:convertFilters\\(\\) has parameter \\$filters with no value type specified in iterable type array\\.$#"
			count: 1
			path: Content/DataProviderResolver/PageDataProviderResolver.php

		-
			message: "#^Method Sulu\\\\Bundle\\\\HeadlessBundle\\\\Content\\\\DataProviderResolver\\\\PageDataProviderResolver\\:\\:extractSortBys\\(\\) has parameter \\$filters with no value type specified in iterable type array\\.$#"
			count: 1
