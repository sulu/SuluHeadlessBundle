		-
			message: "#^Method Sulu\\\\Bundle\\\\HeadlessBundle\\\\Content\\\\DataProviderResolver\\\\SnippetDataProviderResolver\\:\\:convertFilters\\(\\) has parameter \\$filters with no value type specified in iterable type array\\.$#"
			count: 1
